{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START V5 MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END V5 MACROS\n\n\n// Robot configuration code.\ncontroller Controller1 = controller(primary);\nmotor Motor8 = motor(PORT8, ratio18_1, false);\n\nmotor Motor3 = motor(PORT3, ratio18_1, false);\n\nmotor Motor19 = motor(PORT19, ratio18_1, false);\n\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  int systemTime = Brain.Timer.systemHighResolution();\n  double batteryCurrent = Brain.Battery.current();\n  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);\n\n  // Combine these values into a single integer\n  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;\n\n  // Set the seed\n  srand(seed);\n}\n\n\n\nvoid vexcodeInit() {\n\n  //Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// Helper to make playing sounds from the V5 in VEXcode easier and\n// keeps the code cleaner by making it clear what is happening.\nvoid playVexcodeSound(const char *soundName) {\n  printf(\"VEXPlaySound:%s\\n\", soundName);\n  wait(5, msec);\n}\n\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n\n#pragma endregion VEXcode Generated Robot Configuration\n#include <random>\n#include <vector>\n// Include the V5 Library\n#include \"vex.h\"\n  \n// Allows for easier use of the VEX Library\nusing namespace vex;\n\nfloat myVariable;\n\n// \"when started\" hat block\nint whenStarted1() {\n  return 0;\n}\n//idk what this does\nint var = 1;\n\n\n//Test thing. Ignore it. It just drew a circle\nvoid runOnEvent() {\n\n  int thing1 = Brain.Screen.xPosition();\n  int thing2 = Brain.Screen.yPosition();\n  Brain.Screen.drawCircle(thing1,thing2,100);\n\n}\n\n//THESE ARE THE GLOBAL VARIABLES I USE\n  int contx = 0;\n  int conty = 0;\n\n  //I believe these are the circle positions\n\n//Gee I wonder what these bools do\n  bool spinBot = false;\n  bool AIon = false;\n\n  bool yPressedLast = false;\n\n\nvoid thig()\n{\n  spinBot = !spinBot;\n}\n\n\n//THIS IS THE MAIN FUNCTION IM USING. I could've simplified it though and just made like, 4 mini ones\nvoid runOnEvent1() {\n\n  Brain.Screen.clearScreen(); //You want to clear the screen if ur drawing to it.\n\nint forwardSpeed = Controller1.Axis3.position();\nint turnSpeed = Controller1.Axis1.position();\nint deadzone = 5;\n\n// Ignore tiny stick drift\nif (abs(forwardSpeed) < deadzone) forwardSpeed = 0;\nif (abs(turnSpeed) < deadzone) turnSpeed = 0;\n\n// Update screen circle coordinates\nconty -= (forwardSpeed / 10);\ncontx += (turnSpeed / 10);\n\n// Calculate wheel speeds (Motor3 is reversed to match your forward direction)\nint leftMotorSpeed = forwardSpeed + turnSpeed;\nint rightMotorSpeed = -forwardSpeed + turnSpeed;\n\n// Move Motor8 (Left side)\nif (leftMotorSpeed != 0) {\n  Motor8.spin(forward, leftMotorSpeed*2, percent);\n} else {\n  Motor8.stop();\n}\n\n// Move Motor3 (Right side)\nif (rightMotorSpeed != 0) {\n  Motor3.spin(forward, rightMotorSpeed*2, percent);\n} else {\n  Motor3.stop();\n}\n\n//These are for the keypad things on the controller\n\n\nif(Controller1.ButtonRight.pressing())//\n  contx+=5;\n\nelse if(Controller1.ButtonLeft.pressing())\n  contx-=5;\n\nelse if(Controller1.ButtonUp.pressing())\n  conty-=5;\n\nelse if(Controller1.ButtonDown.pressing())\n  conty+=5;\n\n\n\n\n//Controller1.ButtonY.pressed(thig); //{\n  //spinBot = !spinBot;\n//}\n//yPressedLast = yPressedNow;\n\n//HEAVY WORK IN PROGRESS. PLEASE DON'T TOUCH THIS\n\n\n\n\n  //spins the red wheel thing adam talked about if you press x. Don't know what the wheel is for though\n\n  if(Controller1.ButtonX.pressing())\n  {\n    Motor19.spin(forward);\n  }\n\n  else if((!Controller1.ButtonX.pressing() || !Controller1.ButtonY.pressing()) && !spinBot)\n    Motor19.stop();\n\n\n  \n//draw the circle on screen\n  Brain.Screen.drawCircle(contx,conty,100);\n}\n\ncompetition Competition;\n\nvoid autonomous(void) {\n  Motor19.spin(forward,33,percent);\n  wait(1, seconds); // Keep it spinning for 2 seconds so you can see it work\n  Motor19.stop();\n  Motor8.spin(forward, 50, percent);\n  Motor3.spin(reverse, 50, percent);\n  wait(1,seconds);\n  Motor8.stop();\n  Motor3.stop();\n\n\n}\n\nvoid usercontrol(void) {\n  // Register ButtonY ONCE here (remove this line from inside runOnEvent1!)\n  Controller1.ButtonY.pressed(thig);\n\n  while (true) {\n    runOnEvent1();\n    wait(0.05, seconds);\n  }\n}\n\n\n//The code above is like, the ingredients. The main() is actually the pot\n\nint main() {\n  vexcodeInit();\n  whenStarted1();\n\n  Competition.autonomous(autonomous);\n  Competition.drivercontrol(usercontrol);\n\n  // Do NOT put runOnEvent1() here! Just keep main() alive:\n  while (true) {\n  //  runOnEvent1();\n    wait(100, msec);\n  }\n}","textLanguage":"cpp","robotConfig":[{"port":[],"name":"Controller1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[8],"name":"Motor8","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"en avant","rev":"en arrière","gear":"ratio18_1"},"triportSourcePort":22},{"port":[3],"name":"Motor3","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"en avant","rev":"en arrière","gear":"ratio18_1"},"triportSourcePort":22},{"port":[19],"name":"Motor19","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"en avant","rev":"en arrière","gear":"ratio18_1","id":"partner"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.1","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}